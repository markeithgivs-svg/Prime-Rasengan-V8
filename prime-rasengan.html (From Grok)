      if(pos[i*3+1]>CEIL_Y){pos[i*3+1]=CEIL_Y;vel[i*3+1]*=-0.6;}
      const r=Math.sqrt(pos[i*3]*pos[i*3]+pos[i*3+1]*pos[i*3+1]+pos[i*3+2]*pos[i*3+2]);
      if(r>38){const sc=37.5/r;pos[i*3]*=sc;pos[i*3+1]*=sc;pos[i*3+2]*=sc;vel[i*3]*=-0.4;vel[i*3+1]*=-0.4;vel[i*3+2]*=-0.4;}
      dummy.position.set(pos[i*3],pos[i*3+1],pos[i*3+2]);
      dummy.rotation.x+=(0.012+Math.abs(chg[i])*0.008)*speed;dummy.rotation.y+=0.009*speed;
      dummy.scale.setScalar(0.45+0.35*(0.6+0.4*Math.sin(t*2.5*speed+i*0.07)));
      dummy.updateMatrix();mesh.setMatrixAt(i,dummy.matrix);
      if(Math.random()<0.012){const j=(i+1+Math.floor(Math.random()*(N-1)))%N;if(chg[i]*chg[j]<0){const dx=pos[i*3]-pos[j*3],dy=pos[i*3+1]-pos[j*3+1],dz=pos[i*3+2]-pos[j*3+2];if(dx*dx+dy*dy+dz*dz<5.76){const pA=new THREE.Vector3(pos[i*3],pos[i*3+1],pos[i*3+2]).applyEuler(group.rotation),pB=new THREE.Vector3(pos[j*3],pos[j*3+1],pos[j*3+2]).applyEuler(group.rotation);makeCoriolisLine(scene,pA,pB,0xaaffff,0.7,finalPower,0.15,isEverything);}}}
    }
    mesh.instanceMatrix.needsUpdate=true;
    relativisticEnergy+=frameEnergyGain;relativisticEnergy*=0.95;
    const energyRelease=relativisticEnergy*0.2;relativisticEnergy-=energyRelease;
    if(relativisticEnergy>BURST_THRESHOLD){relativisticEnergy=0;burstTimer=1.0;for(let i=0;i<N;i++){const dir=new THREE.Vector3(pos[i*3],pos[i*3+1],pos[i*3+2]).normalize();vel[i*3]+=dir.x*3.5;vel[i*3+1]+=dir.y*3.5;vel[i*3+2]+=dir.z*3.5;}}
    if(burstTimer>0){burstTimer*=0.9;if(burstTimer<0.01)burstTimer=0;}
    heatLightTarget+=energyRelease*0.3;fusionLightTarget+=energyRelease*0.5;
    structure.wall.rotation.z=t*0.0005*speed;structure.wall.material.opacity=0.2+Math.sin(t*2*speed)*0.18;
    mainLight.intensity=(8+Math.sin(t*1.8*speed)*5)*finalPower*(isEverything?2.0:1);
    blueLight.intensity=(4+Math.sin(t*2.3*speed+1)*3)*finalPower;
    blueLight.position.set(Math.cos(t*0.3*speed)*25,Math.sin(t*0.2*speed)*10,Math.sin(t*0.3*speed)*25);
    heatLightTarget*=0.88;fusionLightTarget*=0.88;
    heatLight.intensity=heatLightTarget*finalPower;fusionLight.intensity=fusionLightTarget*finalPower;
    coriolis.parts.forEach(p=>{
      if(p.type==='ring')p.mesh.rotation.z+=p.baseSpeed*0.018*finalPower;
      else if(p.type==='streak'){p.mesh.rotation.y+=p.baseSpeed*0.012*finalPower;p.mesh.material.opacity=0.3+Math.sin(t*8*speed+p.radius)*0.4;}
      else if(p.type==='core'){p.mesh.rotation.z+=p.baseSpeed*0.018*finalPower;p.mesh.material.opacity=0.7+Math.sin(t*12*speed)*0.25;}
      else if(p.type==='halo')p.mesh.rotation.z+=p.baseSpeed*0.015*finalPower;
      else if(p.type==='arm'){p.mesh.rotation.y+=p.baseSpeed*0.004*finalPower;p.mesh.material.opacity=0.2+Math.sin(t*1.5*speed)*0.18;}
    });
    coreLight.intensity=Math.max(0,(15+Math.sin(t*18*speed)*8)*finalPower*(isEverything?1.3:1)+energyRelease*0.2);
    const vs=1.0+Math.sin(t*6*speed)*0.04*bigPulse;coriolis.group.scale.set(vs,1,vs);
    chaosZones.forEach((zone,idx)=>{const angle=t*0.2+zone.phase;zone.pos.x=8*Math.cos(angle+idx);zone.pos.z=8*Math.sin(angle+idx);zone.pos.y=3*Math.sin(t*0.3+idx*2);});
    if(now-lastGolTick>=900){
      lastGolTick=now;gol.tick(hde);
      hde.osmoticTransfers.forEach(({from,to,amount})=>{
        const nF=fusionData.nodes[from],nT=fusionData.nodes[to];if(!nF||!nT)return;
        const pF=nF.pos.clone().applyEuler(group.rotation),pT=nT.pos.clone().applyEuler(group.rotation);
        const lineA=makeCoriolisLine(scene,pF,pT,0xfff4aa,0.9,finalPower,0.07,isEverything);
        const lineB=makeCoriolisLine(scene,pF,pT,0xffffff,0.45,finalPower,0.12,isEverything);
        const burstLines=[];
        for(let b=0;b<Math.min(4,Math.ceil(amount*3));b++){const dir=new THREE.Vector3(Math.random()-0.5,Math.random()-0.5,Math.random()-0.5).normalize();const end=pT.clone().add(dir.multiplyScalar(0.8+amount));burstLines.push(makeCoriolisLine(scene,pT,end,0xffd700,0.85,finalPower,0.04,isEverything));}
        const allLines=[lineA,lineB,...burstLines];let life=0;const maxLife=35;
        const fade=()=>{life++;const f=1-Math.pow(life/maxLife,1.6);allLines.forEach(l=>l.material.opacity=f);if(life<maxLife)requestAnimationFrame(fade);else allLines.forEach(l=>{scene.remove(l);l.geometry.dispose();l.material.dispose();});};
        requestAnimationFrame(fade);fusionLightTarget=Math.min(18,fusionLightTarget+amount*2.5);
      });
      gol.getTriangles().forEach(([ai,bi,ci])=>{
        const na=fusionData.nodes[ai],nb=fusionData.nodes[bi],nc=fusionData.nodes[ci];if(!na||!nb||!nc)return;
        const pA=na.pos.clone().applyEuler(group.rotation),pB=nb.pos.clone().applyEuler(group.rotation),pC=nc.pos.clone().applyEuler(group.rotation);
        triPool.spawn(pA,pB,pC,getDomWithPhase(na),getDomWithPhase(nb),getDomWithPhase(nc),finalPower,isEverything);
      });
      document.getElementById('sAlive').textContent=`alive cells: ${gol.alive.size}`;
      document.getElementById('sGen').textContent=`generation: ${gol.gen}`;
      document.getElementById('sOsmotic').textContent=`osmotic transfers: ${hde.osmoticTransfers.length}`;
    }
    if(now-lastHdeTick>=HDE_TICK_MS){
      lastHdeTick=now;hde.tick();
      hde.destructivePairs.slice(0,8).forEach(({i,j})=>{const ni=fusionData.nodes[i],nj=fusionData.nodes[j];if(!ni||!nj)return;heatPool.spawnDestructive(ni.pos.clone().applyEuler(group.rotation),nj.pos.clone().applyEuler(group.rotation),finalPower,isEverything);});
      heatLightTarget=Math.min(12,hde.destructivePairs.length*0.8);
      hde.redirectionEvents.forEach(({from_i,from_j,to,strength})=>{const ni=fusionData.nodes[from_i],nj=fusionData.nodes[from_j],nk=fusionData.nodes[to];if(!ni||!nj||!nk)return;const pI=ni.pos.clone().applyEuler(group.rotation),pJ=nj.pos.clone().applyEuler(group.rotation),pK=nk.pos.clone().applyEuler(group.rotation);heatPool.spawnRedirection(pI,pJ,pK,finalPower,isEverything);setTimeout(()=>{heatPool.spawnPositive(pK,strength,finalPower,isEverything);fusionLightTarget=Math.min(15,fusionLightTarget+strength*3);},180);});
      document.getElementById('sDestructive').textContent=`destructive pairs: ${hde.destructivePairs.length}`;
      document.getElementById('sRedirected').textContent=`redirected this tick: ${hde.redirectionEvents.length}`;
      document.getElementById('sFusionGain').textContent=`fusion gain: +${hde.fusionGain.toFixed(2)}`;
    }
    triPool.tick();heatPool.tick();
    renderer.render(scene,camera);
    document.getElementById('sRelativistic').textContent=`mass→energy: ${relativisticEnergy.toFixed(1)}`;
    document.getElementById('sBurst').textContent=burstTimer>0.01?`burst: ${burstTimer.toFixed(1)}`:'burst: —';
    if(performance.now()-lastFps>=1000){document.getElementById('sFPS').textContent=`fps: ${fpsCounter}`;fpsCounter=0;lastFps=performance.now();}else fpsCounter++;
  }
  animate();
  window.addEventListener('beforeunload',()=>{cancelAnimationFrame(raf);triPool.clear();heatPool.clear();disposeObject3D(group);disposeObject3D(coriolis.group);renderer.dispose();});
})();
</script>
</body>
